# TWILIGHT THINKS Backend Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/twilight-thinks?retryWrites=true&w=majority

# JWT Authentication Secret (Set this in Render Environment Variables)
JWT_SECRET=your_generated_random_256bit_jwt_secret

# Initial Admin Credentials (used during bootstrap)
ADMIN_EMAIL=admin@twilightthinks.com
ADMIN_PASSWORD=your_secure_admin_password

# Allowed Frontend Origins for CORS (comma-separated if multiple)
CORS_ORIGIN=https://<your-vercel-domain>.vercel.app

# Cloudinary Persistent Image Storage (Required for Production)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Alternatively: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
